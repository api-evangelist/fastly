          "name": "Create a VCL snippet",
          "request": {
            "name": "Create a VCL snippet",
            "description": {
              "content": "Creates a new VCL snippet for a specific version of a Fastly service. Snippets are small pieces of VCL code that can be inserted into specific VCL subroutines.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "service",
                ":service_id",
                "version",
                ":version_id",
                "snippet"
              ],
              "host": [
