                  "description": "(Required) The alphanumeric string identifying the Fastly service."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "version_id",
                  "description": "(Required) The integer identifying the service version."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "name",
                  "value": "<string>",
                  "description": "The name of the VCL snippet."
                },
                {
                  "disabled": false,
                  "key": "content",
                  "value": "<string>",
                  "description": "The VCL code for the snippet."
                },
                {
                  "disabled": false,
                  "key": "type",
                  "value": "<string>",
                  "description": "The VCL subroutine to insert the snippet into."
                },
                {
                  "disabled": false,
                  "key": "dynamic",
                  "value": "<integer>",
                  "description": "Whether this snippet is dynamic (0 = versioned, 1 = dynamic)."
                },
                {
                  "disabled": false,
                  "key": "priority",
                  "value": "100",
                  "description": "The priority of the snippet, determining its order of execution."
                }
              ]
            }
