{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fastly Account ACL Secret Store API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Fastly-Key",
      "value": "{{Fastly-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Secret Store",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List secret stores",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.fastly.com/resources/stores/secret",
            "params": [
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "A cursor for pagination."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "The maximum number of items to return."
              }
            ]
          },
          "docs": "Retrieves a list of all secret stores associated with the account."
        },
        {
          "info": {
            "name": "Create a secret store",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.fastly.com/resources/stores/secret",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new secret store for encrypted storage of credentials and tokens accessible from Compute services."
        },
        {
          "info": {
            "name": "Get a secret store",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.fastly.com/resources/stores/secret/:store_id",
            "params": [
              {
                "name": "store_id",
                "value": "",
                "type": "path",
                "description": "The alphanumeric string identifying the store."
              }
            ]
          },
          "docs": "Retrieves the details of a specific secret store."
        },
        {
          "info": {
            "name": "Delete a secret store",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.fastly.com/resources/stores/secret/:store_id",
            "params": [
              {
                "name": "store_id",
                "value": "",
                "type": "path",
                "description": "The alphanumeric string identifying the store."
              }
            ]
          },
          "docs": "Deletes a specific secret store and all of its secrets."
        }
      ]
    }
  ],
  "bundled": true
}