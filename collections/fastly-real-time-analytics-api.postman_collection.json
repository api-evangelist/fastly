        {
          "id": "13c50862-fa71-4129-887e-685d2e6f1cd2",
          "name": "Get real-time analytics",
          "request": {
            "name": "Get real-time analytics",
            "description": {
              "content": "Retrieves real-time analytics data for a Fastly service starting from the specified Unix timestamp. Returns a list of records, each representing one second of time, with measurement data grouped in various ways. The real-time analytics API is rate limited internally and is cached behind Fastly with a 1-second expiration time.",
              "type": "text/plain"
            },
            "url": {
              "protocol": "https",
              "path": [
                "v1",
                "channel",
                ":service_id",
                "ts",
                ":start_timestamp"
              ],
              "host": [
                "rt",
                "fastly",
                "com"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "service_id",
                  "description": "(Required) The alphanumeric string identifying the Fastly service."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "start_timestamp",
                  "description": "(Required) The Unix timestamp to start retrieving analytics data from."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
