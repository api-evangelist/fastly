{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fastly Account ACL IAM Service Groups API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Fastly-Key",
      "value": "{{Fastly-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "IAM Service Groups",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List IAM service groups",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.fastly.com/service-groups",
            "params": [
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "The number of items per page."
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "The cursor for pagination."
              }
            ]
          },
          "docs": "Retrieves a list of all service groups used for access control."
        },
        {
          "info": {
            "name": "Create an IAM service group",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.fastly.com/service-groups",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new service group for organizing services."
        }
      ]
    }
  ],
  "bundled": true
}