{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fastly Account ACL Backend API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Fastly-Key",
      "value": "{{Fastly-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Backend",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List backends",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.fastly.com/service/:service_id/version/:version_id/backend",
            "params": [
              {
                "name": "service_id",
                "value": "",
                "type": "path",
                "description": "The alphanumeric string identifying the Fastly service."
              },
              {
                "name": "version_id",
                "value": "",
                "type": "path",
                "description": "The integer identifying the service version."
              }
            ]
          },
          "docs": "Retrieves a list of all backends configured for a specific version of a Fastly service."
        },
        {
          "info": {
            "name": "Create a backend",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.fastly.com/service/:service_id/version/:version_id/backend",
            "params": [
              {
                "name": "service_id",
                "value": "",
                "type": "path",
                "description": "The alphanumeric string identifying the Fastly service."
              },
              {
                "name": "version_id",
                "value": "",
                "type": "path",
                "description": "The integer identifying the service version."
              }
            ],
            "body": {
              "type": "form-urlencoded",
              "data": []
            }
          },
          "docs": "Creates a new backend for a specific version of a Fastly service. Backends define the origin servers that Fastly routes requests to."
        },
        {
          "info": {
            "name": "Get a backend",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.fastly.com/service/:service_id/version/:version_id/backend/:backend_name",
            "params": [
              {
                "name": "service_id",
                "value": "",
                "type": "path",
                "description": "The alphanumeric string identifying the Fastly service."
              },
              {
                "name": "version_id",
                "value": "",
                "type": "path",
                "description": "The integer identifying the service version."
              },
              {
                "name": "backend_name",
                "value": "",
                "type": "path",
                "description": "The name of the backend."
              }
            ]
          },
          "docs": "Retrieves the details of a specific backend for a version of a Fastly service."
        },
        {
          "info": {
            "name": "Update a backend",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.fastly.com/service/:service_id/version/:version_id/backend/:backend_name",
            "params": [
              {
                "name": "service_id",
                "value": "",
                "type": "path",
                "description": "The alphanumeric string identifying the Fastly service."
              },
              {
                "name": "version_id",
                "value": "",
                "type": "path",
                "description": "The integer identifying the service version."
              },
              {
                "name": "backend_name",
                "value": "",
                "type": "path",
                "description": "The name of the backend."
              }
            ],
            "body": {
              "type": "form-urlencoded",
              "data": []
            }
          },
          "docs": "Updates a specific backend for a version of a Fastly service."
        },
        {
          "info": {
            "name": "Delete a backend",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.fastly.com/service/:service_id/version/:version_id/backend/:backend_name",
            "params": [
              {
                "name": "service_id",
                "value": "",
                "type": "path",
                "description": "The alphanumeric string identifying the Fastly service."
              },
              {
                "name": "version_id",
                "value": "",
                "type": "path",
                "description": "The integer identifying the service version."
              },
              {
                "name": "backend_name",
                "value": "",
                "type": "path",
                "description": "The name of the backend."
              }
            ]
          },
          "docs": "Deletes a specific backend from a version of a Fastly service."
        }
      ]
    }
  ],
  "bundled": true
}