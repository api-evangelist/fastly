          "id": "ad4f72af-d373-4827-ba13-4c2bf544cecb",
          "name": "Create cache settings",
          "request": {
            "name": "Create cache settings",
            "description": {
              "content": "Creates new cache settings for a specific version of a Fastly service. Cache settings configure cache lifetime for objects stored in the Fastly cache, overriding cache freshness information from HTTP headers.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "service",
                ":service_id",
                "version",
                ":version_id",
                "cache_settings"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "service_id",
                  "description": "(Required) The alphanumeric string identifying the Fastly service."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "version_id",
                  "description": "(Required) The integer identifying the service version."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "name",
                  "value": "<string>",
                  "description": "The name of the cache settings rule."
                },
                {
                  "disabled": false,
                  "key": "action",
                  "value": "<string>",
                  "description": "The action to take when the cache settings are applied."
                },
                {
                  "disabled": false,
                  "key": "ttl",
                  "value": "<integer>",
                  "description": "The maximum time in seconds that the object should be cached."
                },
                {
                  "disabled": false,
                  "key": "stale_ttl",
                  "value": "<integer>",
                  "description": "The maximum time in seconds that a stale object can be served."
                },
                {
                  "disabled": false,
                  "key": "cache_condition",
                  "value": "<string>",
                  "description": "The name of the condition that triggers these cache settings."
                }
              ]
            }
          },
